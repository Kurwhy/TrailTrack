# Aplikasi
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database MySQL
DATABASE_URL=mysql://trailtrack:ganti_password@localhost:3306/trailtrack

# Autentikasi Staf
JWT_SECRET=ganti_dengan_string_acak_panjang
ADMIN_SEED_EMAIL=staf@trailtrack.example
ADMIN_SEED_PASSWORD=ganti_password_awal

# Aturan Bisnis (sumber: Bab 6)
BUFFER_HARI=1
GRACE_JAM=2
JAM_BATAS_KEMBALI=12:00
DP_PERSEN=30
TELAT_BATAS=2

# Midtrans
# Server key hanya dipakai backend. Client key harus sama dengan
# VITE_MIDTRANS_CLIENT_KEY pada akun dan environment yang sama.
MIDTRANS_SERVER_KEY=SB-Mid-server-ganti
MIDTRANS_CLIENT_KEY=SB-Mid-client-ganti
MIDTRANS_IS_PRODUCTION=false

# Frontend (Vite)
VITE_API_URL=http://localhost:4000/api
VITE_BUFFER_HARI=1
VITE_GRACE_JAM=2
VITE_JAM_BATAS_KEMBALI=12:00
VITE_DP_PERSEN=30
VITE_TELAT_BATAS=2
VITE_ADMIN_EMAIL=staf@trailtrack.example
VITE_ADMIN_PASSWORD=trailtrack123
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-ganti
VITE_MIDTRANS_SNAP_JS_URL=https://app.sandbox.midtrans.com/snap/snap.js
