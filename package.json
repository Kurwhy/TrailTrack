{
  "name": "trailtrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -n web,api -c yellow,cyan \"vite\" \"tsx watch server/src/index.ts\"",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.build.json && node -e \"require('fs').writeFileSync('server/dist/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "build:all": "npm run build && npm run build:server",
    "start:server": "node server/dist/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config=server/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=server/drizzle.config.ts",
    "db:seed": "tsx server/src/db/seed.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "framer-motion": "^11.11.9",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.451.0",
    "mysql2": "^3.24.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
